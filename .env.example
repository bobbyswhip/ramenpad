# Public Robinhood RPC is rate-limited. Use an Alchemy/QuickNode WebSocket in production.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_WS_URL=

# Filled after deployment.
RAMENPAD_LAUNCHER_ADDRESS=
RAMENPAD_OTC_ADDRESS=
RAMENPAD_LOCKER_ADDRESS=
RAMENPAD_ETH_ROUTER_ADDRESS=0x04231d4EBa71Fd75C3e124E9b332BBB445FA076e
RAMENPAD_TARGET_2000_ACTIVATION_BLOCK=52219736
VITE_RAMENPAD_LAUNCHER_ADDRESS=
VITE_API_URL=http://localhost:4311/api/ramenpad

# Backend-only secrets. Never use the owner/deployer key as this hot quote signer.
RAMENPAD_QUOTE_SIGNER_PRIVATE_KEY=
RAMENPAD_KEEPER_PRIVATE_KEY=
RAMENPAD_KEEPER_INTERVAL_MS=600000
RAMENPAD_KEEPER_BATCH_SIZE=25
RAMENPAD_KEEPER_MIN_HARVEST=1000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ramenpad
PORT=4311
PUBLIC_BASE_URL=http://localhost:4311

# Deployment-only. Keep this in secrets/.env.deploy, never in a tracked env file.
RAMENPAD_DEPLOYER_PRIVATE_KEY=
RAMENPAD_OWNER_ADDRESS=
RAMENPAD_DEV_ADDRESS=
