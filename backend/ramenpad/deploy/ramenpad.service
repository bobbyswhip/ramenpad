[Unit]
Description=RamenPad API and Robinhood Chain indexer
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/ramenpad-backend
EnvironmentFile=/home/ec2-user/ramenpad-backend/.env
ExecStart=/home/ec2-user/.nvm/versions/node/v22.22.2/bin/node dist/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ec2-user/ramenpad-backend/uploads

[Install]
WantedBy=multi-user.target
